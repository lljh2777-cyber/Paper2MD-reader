{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node", "chrome"]
  },
  "include": [
    "src/**/*.ts",
    "local-reader/**/*.ts",
    "apps/**/*.ts",
    "packages/**/*.ts",
    "test/**/*.ts"
  ]
}
