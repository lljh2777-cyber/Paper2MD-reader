{
  "manifest_version": 3,
  "key": "",
  "name": "After-MinerU Companion",
  "version": "0.1.0",
  "description": "Clip paper pages or run an explicit, memory-only MinerU precision conversion without a Paper2MD cloud backend.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "After-MinerU Companion"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
