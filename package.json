{
  "name": "paper2md-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Contract-driven Paper2MD reading views for Obsidian and local browser directories.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "local:build": "vite build --config vite.local.config.mjs",
    "local:dev": "vite --config vite.local.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
