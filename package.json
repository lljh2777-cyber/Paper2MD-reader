{
  "name": "paper2md-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contract-driven Paper2MD Reader for web, Electron desktop, and Obsidian hosts.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "local:build": "vite build --config vite.local.config.mjs",
    "local:dev": "vite --config vite.local.config.mjs",
    "web:build": "vite build --config apps/web/vite.config.mjs",
    "web:dev": "vite --config apps/web/vite.config.mjs",
    "reader:dev": "node scripts/reader-dev.mjs",
    "clipper:build": "npm run build --workspace @paper2md/clipper-extension",
    "processing:build": "npm run build --workspace @paper2md/processing-service",
    "processing:start": "npm run start --workspace @paper2md/processing-service",
    "desktop:build": "node apps/desktop/build.mjs",
    "desktop:start": "electron apps/desktop",
    "desktop:dev": "npm run desktop:build && electron apps/desktop",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "fflate": "^0.8.2",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/chrome": "^0.1.33",
    "defuddle": "^0.19.3",
    "@types/node": "^22.10.2",
    "electron": "43.2.0",
    "esbuild": "^0.28.1",
    "linkedom": "^0.18.12",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
